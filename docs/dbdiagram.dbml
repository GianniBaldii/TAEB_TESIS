Project TAEB_TESIS {
  database_type: "MySQL"
  Note: "Diagrama DBML de las tablas principales del proyecto. Incluye tablas propias y referencia a auth_user de Django."
}

Table auth_user {
  id int [pk, increment]
  username varchar(150) [unique]
  first_name varchar(150)
  last_name varchar(150)
  email varchar(254)
  password varchar(128)
  is_staff bool
  is_active bool
  is_superuser bool
  last_login datetime
  date_joined datetime

  Note: "Tabla estándar de usuarios de Django."
}

Table usuarios_docentes {
  id bigint [pk, increment]
  id_usuario int [not null, unique]
  dni varchar(20) [not null, unique]
  telefono varchar(30)
  fecha_nacimiento date
  activo bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table escuelas {
  id bigint [pk, increment]
  nombre varchar(150) [not null]
  nombre_comercial varchar(150)
  razon_social varchar(150)
  cuit varchar(20)
  email varchar(254)
  telefono varchar(30)
  direccion varchar(255)
  ciudad varchar(100)
  provincia varchar(100)
  activo bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table escuelas_docentes {
  id bigint [pk, increment]
  id_escuela bigint [not null]
  id_docente bigint [not null]
  rol varchar(20) [not null, default: "DOCENTE", note: "ADMINISTRADOR | DOCENTE | COORDINADOR"]
  activo bool [not null, default: true]
  fecha_alta date [not null]
  fecha_baja date

  Indexes {
    (id_escuela, id_docente) [unique, name: "uq_escuela_docente"]
  }
}

Table alumnos_cinturones {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  color varchar(80) [not null]
  tipo_rango varchar(3) [not null, note: "GUP | DAN"]
  numeracion smallint [not null]
  orden smallint [not null, unique]
  activo bool [not null, default: true]

  Indexes {
    (tipo_rango, numeracion) [unique, name: "cinturon_tipo_rango_numeracion_unicos"]
  }
}

Table alumnos {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  apellido varchar(100) [not null]
  dni varchar(20) [not null, unique]
  fecha_nacimiento date
  fecha_inicio_taekwondo date
  email varchar(254) [unique]
  telefono varchar(30)
  direccion varchar(255)
  peso_aproximado decimal(5,2)
  altura_aproximada decimal(4,2)
  id_cinturon_actual bigint
  activo bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table alumnos_escuelas {
  id bigint [pk, increment]
  id_alumno bigint [not null]
  id_escuela bigint [not null]
  activo bool [not null, default: true]
  fecha_inscripcion date [not null]
  fecha_baja date
  observaciones text
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]

  Indexes {
    (id_alumno, id_escuela) [unique, name: "uq_alumno_escuela"]
  }
}

Table alumnos_examenes_plantillas {
  id bigint [pk, increment]
  id_cinturon bigint [not null]
  nombre varchar(150) [not null]
  descripcion text
  nota_minima_aprobacion decimal(5,2)
  version smallint [not null, default: 1]
  id_plantilla_origen bigint
  vigente_desde date
  vigente_hasta date
  activo bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table alumnos_examenes_plantillas_secciones {
  id bigint [pk, increment]
  id_plantilla bigint [not null]
  nombre varchar(100) [not null]
  descripcion text
  orden smallint [not null, default: 1]
  obligatorio bool [not null, default: true]
  activo bool [not null, default: true]

  Indexes {
    (id_plantilla, nombre) [unique, name: "seccion_template_nombre_unicos"]
  }
}

Table alumnos_examenes_plantillas_items {
  id bigint [pk, increment]
  id_seccion bigint [not null]
  nombre varchar(150) [not null]
  descripcion text
  tipo_evaluacion varchar(10) [not null, note: "NUMERICA | CONCEPTO | TEXTO | CHECK"]
  orden smallint [not null, default: 1]
  puntaje_maximo decimal(5,2)
  ponderacion decimal(5,2) [not null, default: 1]
  obligatorio bool [not null, default: true]
  activo bool [not null, default: true]
}

Table alumnos_examenes {
  id bigint [pk, increment]
  id_alumno bigint [not null]
  id_plantilla bigint [not null]
  id_cinturon_origen bigint [not null]
  id_cinturon_destino bigint [not null]
  fecha_examen date [not null]
  lugar varchar(150)
  es_historico bool [not null, default: false]
  estado varchar(12) [not null, default: "PENDIENTE", note: "PENDIENTE | APROBADO | DESAPROBADO | AUSENTE | ANULADO"]
  nota_final decimal(5,2)
  resultado_final varchar(20)
  observaciones text
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table alumnos_examenes_detalles {
  id bigint [pk, increment]
  id_examen bigint [not null]
  id_plantilla_item bigint [not null]
  nota_numerica decimal(5,2)
  concepto varchar(50)
  valor_texto text
  aprobado bool
  observaciones text

  Indexes {
    (id_examen, id_plantilla_item) [unique, name: "detalle_examen_template_item_unicos"]
  }
}

Table alumnos_cinturones_historial {
  id bigint [pk, increment]
  id_alumno bigint [not null]
  id_cinturon bigint [not null]
  id_examen bigint [unique]
  fecha_obtencion date [not null]
  observaciones text
  fecha_creacion datetime [not null]

  Indexes {
    (id_alumno, id_cinturon) [unique, name: "historial_alumno_cinturon_unicos"]
  }
}

Table finanzas_conceptos {
  id bigint [pk, increment]
  id_escuela bigint [not null]
  codigo varchar(20) [not null, note: "CUOTA | EXAMEN | TORNEO"]
  nombre varchar(100) [not null]
  descripcion text
  activo bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
  Indexes { (id_escuela, codigo) [unique, name: "uq_finanzas_concepto_escuela_codigo"] }
}

Table finanzas_configuraciones_cuota {
  id bigint [pk, increment]
  id_escuela bigint [not null, unique]
  monto_actual decimal(12,2) [not null]
  dia_vencimiento smallint [not null]
  dias_tolerancia smallint [not null]
  activa bool [not null, default: true]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table finanzas_obligaciones {
  id bigint [pk, increment]
  id_escuela bigint [not null]
  id_alumno_escuela bigint [not null]
  id_concepto_financiero bigint [not null]
  descripcion varchar(255) [not null]
  monto_original decimal(12,2) [not null]
  periodo_anio smallint
  periodo_mes smallint
  fecha_generacion date [not null]
  fecha_vencimiento date [not null]
  fecha_atraso date [not null]
  clave_origen varchar(100) [unique]
  estado_operativo varchar(10) [not null, note: "ACTIVA | ANULADA"]
  id_usuario_creacion int [not null]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table finanzas_pagos {
  id bigint [pk, increment]
  id_escuela bigint [not null]
  id_alumno_escuela bigint [not null]
  monto_total decimal(12,2) [not null]
  metodo_pago varchar(20) [not null, note: "EFECTIVO | TRANSFERENCIA"]
  estado varchar(12) [not null, note: "PENDIENTE | CONFIRMADO | ANULADO"]
  fecha_pago date [not null]
  referencia varchar(150)
  observaciones text
  id_usuario_registro int [not null]
  fecha_creacion datetime [not null]
  fecha_modificacion datetime [not null]
}

Table finanzas_pagos_aplicaciones {
  id bigint [pk, increment]
  id_pago bigint [not null]
  id_obligacion_pago bigint [not null]
  monto_aplicado decimal(12,2) [not null]
  Indexes { (id_pago, id_obligacion_pago) [unique, name: "uq_finanzas_pago_obligacion"] }
}

Ref: usuarios_docentes.id_usuario - auth_user.id [delete: restrict]

Ref: escuelas_docentes.id_escuela > escuelas.id [delete: restrict]
Ref: escuelas_docentes.id_docente > usuarios_docentes.id [delete: restrict]

Ref: alumnos.id_cinturon_actual > alumnos_cinturones.id [delete: restrict]
Ref: alumnos_escuelas.id_alumno > alumnos.id [delete: restrict]
Ref: alumnos_escuelas.id_escuela > escuelas.id [delete: restrict]

Ref: alumnos_examenes_plantillas.id_cinturon > alumnos_cinturones.id [delete: restrict]
Ref: alumnos_examenes_plantillas.id_plantilla_origen > alumnos_examenes_plantillas.id [delete: restrict]
Ref: alumnos_examenes_plantillas_secciones.id_plantilla > alumnos_examenes_plantillas.id [delete: cascade]
Ref: alumnos_examenes_plantillas_items.id_seccion > alumnos_examenes_plantillas_secciones.id [delete: cascade]

Ref: alumnos_examenes.id_alumno > alumnos.id [delete: restrict]
Ref: alumnos_examenes.id_plantilla > alumnos_examenes_plantillas.id [delete: restrict]
Ref: alumnos_examenes.id_cinturon_origen > alumnos_cinturones.id [delete: restrict]
Ref: alumnos_examenes.id_cinturon_destino > alumnos_cinturones.id [delete: restrict]

Ref: alumnos_examenes_detalles.id_examen > alumnos_examenes.id [delete: cascade]
Ref: alumnos_examenes_detalles.id_plantilla_item > alumnos_examenes_plantillas_items.id [delete: restrict]

Ref: alumnos_cinturones_historial.id_alumno > alumnos.id [delete: restrict]
Ref: alumnos_cinturones_historial.id_cinturon > alumnos_cinturones.id [delete: restrict]
Ref: alumnos_cinturones_historial.id_examen - alumnos_examenes.id [delete: restrict]

Ref: finanzas_conceptos.id_escuela > escuelas.id [delete: restrict]
Ref: finanzas_configuraciones_cuota.id_escuela - escuelas.id [delete: restrict]
Ref: finanzas_obligaciones.id_escuela > escuelas.id [delete: restrict]
Ref: finanzas_obligaciones.id_alumno_escuela > alumnos_escuelas.id [delete: restrict]
Ref: finanzas_obligaciones.id_concepto_financiero > finanzas_conceptos.id [delete: restrict]
Ref: finanzas_obligaciones.id_usuario_creacion > auth_user.id [delete: restrict]
Ref: finanzas_pagos.id_escuela > escuelas.id [delete: restrict]
Ref: finanzas_pagos.id_alumno_escuela > alumnos_escuelas.id [delete: restrict]
Ref: finanzas_pagos.id_usuario_registro > auth_user.id [delete: restrict]
Ref: finanzas_pagos_aplicaciones.id_pago > finanzas_pagos.id [delete: restrict]
Ref: finanzas_pagos_aplicaciones.id_obligacion_pago > finanzas_obligaciones.id [delete: restrict]
